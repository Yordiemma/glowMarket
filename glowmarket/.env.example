NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only. Never add NEXT_PUBLIC_ to this variable.
OPENAI_API_KEY=your_new_secret_key

# Bolagsverket Accept2/test environment. All four variables are server-only.
BOLAGSVERKET_CLIENT_ID=your_test_client_id
BOLAGSVERKET_CLIENT_SECRET=your_test_client_secret
BOLAGSVERKET_TOKEN_URL=https://portal-accept2.api.bolagsverket.se/oauth2/token
BOLAGSVERKET_BASE_URL=https://gw-accept2.api.bolagsverket.se/vardefulla-datamangder/v1

# Optional local testing only. This is ignored in production.
LOCAL_AUTH_BYPASS=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
