NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only. Never add NEXT_PUBLIC_ to this variable.
OPENAI_API_KEY=your_new_secret_key

# Optional local testing only. This is ignored in production.
LOCAL_AUTH_BYPASS=false

# Server-only Stripe credentials. Payments remain disabled without these.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
